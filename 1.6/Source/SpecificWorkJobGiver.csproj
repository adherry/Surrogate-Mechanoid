<Project Sdk="Microsoft.NET.Sdk">
  <!-- RimWorld 1.6 (Unity, .NET Framework 4.8). Build with: dotnet build -c Release 1.6/Source/SpecificWorkJobGiver.csproj -->
  <PropertyGroup>
    <AssemblyName>SpecificWorkJobGiver</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net48</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <OutputPath>..\Assemblies\</OutputPath>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Deep drill patch left out: Wecardo.TunnulerFix handles mechs operating deep drills. -->
    <Compile Remove="SpecificWorkJobGiver.MechFriendly\MechFriendly_JobDriver_OperateDeepDrill.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" ExcludeAssets="runtime" />
    <!-- The 1.6 Harmony mod ships 0Harmony 2.x. -->
    <PackageReference Include="Lib.Harmony.Ref" Version="2.3.6" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
